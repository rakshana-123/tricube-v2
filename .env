# Frontend env (copy to .env.local at the project root)
VITE_API_URL=http://localhost:5000
VITE_DEMO_PAYMENTS=false
# Razorpay: the Key Id is served by the backend at order-create time.
# Do NOT set a Razorpay key here — keeping a single source in backend/.env
# prevents the frontend and backend from drifting between test/live keys.