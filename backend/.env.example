# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# MySQL (local)
DATABASE_URL="mysql://root:yourpassword@localhost:3306/tricube_lms"

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Razorpay
# Get these from https://dashboard.razorpay.com/app/keys (Test Mode)
# IMPORTANT: The frontend does NOT read a Razorpay key from its own env.
# The Key Id below is returned by the backend at order-create time so both sides
# can never drift. Only change these values here.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_test_key_secret_here
# Set later after configuring a webhook (ngrok or deployed URL) in the Razorpay dashboard
# This value MUST equal the "Secret" you enter in the Razorpay Dashboard webhook page.
RAZORPAY_WEBHOOK_SECRET=whsec_optional_for_now

# Nodemailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
SMTP_FROM="TRI CUBE <tricubedigitalsolutions@gmail.com>"
ADMIN_EMAIL=tricubedigitalsolutions@gmail.com

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100

# Frontend
FRONTEND_URL=http://localhost:5173

# Admin bootstrap (seed script)
SEED_ADMIN_EMAIL=tricubedigitalsolutions@gmail.com
SEED_ADMIN_PASSWORD=Admin@12345